<Window x:Class="OpenCalendar.UI.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource InkBrush}" UseLayoutRounding="True">
    <Border Margin="10" Background="{StaticResource SurfaceBrush}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource CardShadow}" ClipToBounds="False">
        <Grid>
            <Border Width="4" HorizontalAlignment="Left" CornerRadius="14,0,0,14" Background="{StaticResource AccentBrush}" />
            <Grid Margin="18,14,10,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <TextBlock x:Name="Glyph" Text="&#xEA8F;" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="WhenText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,2" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource CaptionText}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10" Content="&#xE8BB;"
                        VerticalAlignment="Top" Click="OnDismiss" ToolTip="Bezárás" />

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Megnyitás" Padding="14,6" Click="OnOpen" />
                    <Button Style="{StaticResource SecondaryButton}" Content="5 perc múlva" Padding="12,5" Margin="8,0,0,0" Tag="5" Click="OnSnooze" ToolTip="Szundi" />
                    <Button Style="{StaticResource SecondaryButton}" Content="15 perc" Padding="12,5" Margin="6,0,0,0" Tag="15" Click="OnSnooze" ToolTip="Szundi" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="OpenCalendar.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenCalendar.UI.Controls"
        xmlns:models="clr-namespace:OpenCalendar.Core.Models"
        Title="openCalendar"
        Width="1360" Height="860" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/openCalendar.ico"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource InkBrush}"
        Background="{StaticResource SurfaceBrush}"
        UseLayoutRounding="True"
        AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewEventCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding GoTodayCommand}" />
        <KeyBinding Gesture="Ctrl+Left" Command="{Binding PreviousCommand}" />
        <KeyBinding Gesture="Ctrl+Right" Command="{Binding NextCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextCommand}" />
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding SetViewCommand}" CommandParameter="{x:Static models:CalendarViewMode.Day}" />
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding SetViewCommand}" CommandParameter="{x:Static models:CalendarViewMode.Week}" />
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding SetViewCommand}" CommandParameter="{x:Static models:CalendarViewMode.Month}" />
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding SetViewCommand}" CommandParameter="{x:Static models:CalendarViewMode.Agenda}" />
        <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ Title bar ═══════════ -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Width="262">
                    <Image Source="/Assets/icon.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="open" FontSize="17" FontWeight="Bold" Margin="10,0,0,1" VerticalAlignment="Center" />
                    <TextBlock Text="Calendar" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,1" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource SecondaryButton}" Content="Ma" Padding="14,6" Command="{Binding GoTodayCommand}" ToolTip="Ugrás a mai napra  (Ctrl+T)" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Margin="10,0,0,0" Command="{Binding PreviousCommand}" ToolTip="Előző  (PgUp)" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextCommand}" ToolTip="Következő  (PgDn)" />
                    <TextBlock Text="{Binding PeriodTitle}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- View mode -->
                <Border Grid.Column="3" Style="{StaticResource SegmentedHost}" VerticalAlignment="Center" Margin="0,0,14,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedItem}" GroupName="View" Content="Nap" ToolTip="Ctrl+1"
                                     IsChecked="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:CalendarViewMode.Day}}" />
                        <RadioButton Style="{StaticResource SegmentedItem}" GroupName="View" Content="Hét" ToolTip="Ctrl+2"
                                     IsChecked="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:CalendarViewMode.Week}}" />
                        <RadioButton Style="{StaticResource SegmentedItem}" GroupName="View" Content="Hónap" ToolTip="Ctrl+3"
                                     IsChecked="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:CalendarViewMode.Month}}" />
                        <RadioButton Style="{StaticResource SegmentedItem}" GroupName="View" Content="Napló" ToolTip="Ctrl+4"
                                     IsChecked="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:CalendarViewMode.Agenda}}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource PrimaryButton}" Padding="14,8" Command="{Binding NewEventCommand}" ToolTip="Új esemény  (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="11" Margin="0,0,8,0" />
                            <TextBlock Text="Új esemény" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="8,0,0,0" ToolTip="További műveletek"
                            Click="OnMoreClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Naptár importálása…" Tag="&#xE8B5;" Command="{Binding ImportCommand}" InputGestureText="Ctrl+I" />
                                <MenuItem Header="Összes naptár exportálása…" Tag="&#xE898;" Command="{Binding ExportAllCommand}" />
                                <Separator />
                                <MenuItem Header="Adatmappa megnyitása" Tag="&#xE838;" Command="{Binding OpenDataFolderCommand}" />
                                <MenuItem Header="Beállítások" Tag="&#xE713;" Command="{Binding OpenSettingsCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}" ToolTip="Beállítások  (Ctrl+,)" />
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeClick" ToolTip="Kis méret" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximizeClick" ToolTip="Teljes méret" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="Bezárás" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Body ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,16,14,16">
                    <StackPanel>
                        <controls:MiniCalendar DataContext="{Binding MiniCalendar}" />

                        <!-- My calendars -->
                        <Grid Margin="2,20,0,6">
                            <TextBlock Text="NAPTÁRAIM" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE710;"
                                    HorizontalAlignment="Right" Command="{Binding NewCalendarCommand}" ToolTip="Új naptár" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Calendars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Grid.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Szerkesztés (név, szín)…" Tag="&#xE70F;" Command="{Binding EditCalendarCommand}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Exportálás .opencalendar fájlba…" Tag="&#xE898;" Command="{Binding ExportCalendarCommand}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="Törlés" Tag="&#xE74D;" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteCalendarCommand}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <CheckBox Style="{StaticResource CalendarCheck}" Tag="{Binding Color}" IsChecked="{Binding IsVisible}"
                                                  ToolTip="Jobb klikk: szerkesztés, exportálás, törlés">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </CheckBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- openNotes deadlines -->
                        <StackPanel Visibility="{Binding IsNotesSyncEnabled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="OPENNOTES" Style="{StaticResource SectionLabel}" Margin="2,16,0,6" />
                            <CheckBox Style="{StaticResource CalendarCheck}" Tag="#5B3E96" IsChecked="{Binding ShowNotesCalendar}"
                                      ToolTip="A jegyzetekhez beállított határidők automatikusan megjelennek">
                                <StackPanel>
                                    <TextBlock Text="Jegyzet határidők" />
                                    <TextBlock Text="{Binding NotesStatusText}" Style="{StaticResource CaptionText}" FontSize="11" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <!-- openKanban deadlines -->
                        <StackPanel Visibility="{Binding IsKanbanSyncEnabled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="OPENKANBAN" Style="{StaticResource SectionLabel}" Margin="2,16,0,6" />
                            <CheckBox Style="{StaticResource CalendarCheck}" Tag="#2F5A8A" IsChecked="{Binding ShowKanbanCalendar}"
                                      ToolTip="A határidős kártyák automatikusan megjelennek">
                                <StackPanel>
                                    <TextBlock Text="Kártya határidők" />
                                    <TextBlock Text="{Binding KanbanStatusText}" Style="{StaticResource CaptionText}" FontSize="11" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <!-- Upcoming -->
                        <TextBlock Text="KÖZELGŐ" Style="{StaticResource SectionLabel}" Margin="2,18,0,6" />
                        <ItemsControl ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource AgendaEntryTemplate}" />
                        <TextBlock Text="Nincs közelgő esemény a következő két hétben." Style="{StaticResource CaptionText}" Margin="4,2,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding HasUpcoming, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Views -->
            <Grid Grid.Column="1">
                <controls:WeekView Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter='Day,Week'}" />
                <controls:MonthView Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Month}" />
                <controls:AgendaView Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Agenda}" />
            </Grid>
        </Grid>
    </Grid>
</Window>

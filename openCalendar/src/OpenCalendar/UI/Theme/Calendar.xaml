<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:OpenCalendar.UI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:MinuteToPixelConverter x:Key="MinuteToPixel" />
    <conv:TopMarginConverter x:Key="TopMargin" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />

    <!-- ───────────── ComboBox ───────────── -->
    <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1" CornerRadius="9">
            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource InkMutedBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0,32,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource ComboToggleTemplate}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Margin="8,0,8,10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4"
                                    Effect="{StaticResource CardShadow}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSofterBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────────── Radio option (circle + text) ───────────── -->
    <Style x:Key="RadioOption" TargetType="RadioButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1.6" Fill="{StaticResource SurfaceBrush}" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Visibility="Hidden" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colour swatch (Tag = "#RRGGBB"). -->
    <Style x:Key="SwatchRadio" TargetType="RadioButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                        <Ellipse Margin="4" Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexToBrush}}" />
                        <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexToBrush}}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colour check box for the calendar list (Tag = "#RRGGBB"). -->
    <Style x:Key="CalendarCheck" TargetType="CheckBox" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="5" Margin="0,0,10,0" BorderThickness="2"
                                    BorderBrush="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexToBrush}}"
                                    Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexToBrush}}">
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSofterBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain clickable surface (entries, cells); content defines the look. -->
    <Style x:Key="BareButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row button with hover background (agenda, upcoming). -->
    <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSofterBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small round day button of the mini calendar. -->
    <Style x:Key="MiniDayButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Bg" Width="27" Height="27" Fill="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Weekday toggle (H K Sze ...) in the recurrence editor. -->
    <Style x:Key="DayToggle" TargetType="ToggleButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="16">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ───────────── Entry templates (DataContext of the Window = MainViewModel) ───────────── -->

    <!-- Month cell chip: dot · time · title (all-day: tinted bar). -->
    <DataTemplate x:Key="MonthEntryTemplate">
        <Button x:Name="Root" Style="{StaticResource BareButton}" Margin="0,0,0,2" ToolTip="{Binding ToolTipText}"
                Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
            <Border x:Name="Chip" CornerRadius="5" Padding="5,2" Background="Transparent">
                <DockPanel>
                    <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                             Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
                    <TextBlock x:Name="Time" DockPanel.Dock="Left" Text="{Binding ShortTime}" FontSize="11" Margin="0,0,4,0"
                               Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAllDay}" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=soft}" />
                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Time" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                <Setter TargetName="TitleText" Property="Opacity" Value="0.6" />
            </DataTrigger>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=medium}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- All-day row of the week / day view. -->
    <DataTemplate x:Key="AllDayEntryTemplate">
        <Button x:Name="Root" Style="{StaticResource BareButton}" Margin="0,0,0,2" ToolTip="{Binding ToolTipText}"
                Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
            <Border x:Name="Chip" CornerRadius="5" Padding="6,2" BorderThickness="3,0,0,0"
                    Background="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=soft}"
                    BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}">
                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=text}" />
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
            </DataTrigger>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=medium}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Timed block in the hour grid. -->
    <DataTemplate x:Key="TimedEntryTemplate">
        <Button x:Name="Root" Style="{StaticResource BareButton}" ToolTip="{Binding ToolTipText}"
                Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
            <Border x:Name="Block" CornerRadius="6" Padding="7,3,5,3" BorderThickness="3,0,0,0" ClipToBounds="True"
                    Background="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=soft}"
                    BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE8EE;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="4,2,0,0"
                                   Foreground="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=text}"
                                   Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}" ToolTip="Ismétlődő" />
                        <TextBlock DockPanel.Dock="Right" Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="4,2,0,0"
                                   Foreground="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=text}"
                                   Visibility="{Binding HasLinkedNote, Converter={StaticResource BoolToVis}}" ToolTip="Kapcsolt jegyzet" />
                        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="34"
                                   Foreground="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=text}" />
                    </DockPanel>
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource InkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource InkMutedBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                <Setter TargetName="Block" Property="Opacity" Value="0.6" />
            </DataTrigger>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                <Setter TargetName="Block" Property="Background" Value="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=medium}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Row in the agenda list and the sidebar "Közelgő" list. -->
    <DataTemplate x:Key="AgendaEntryTemplate">
        <Button Style="{StaticResource RowButton}" ToolTip="{Binding ToolTipText}"
                Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="4" CornerRadius="2" Margin="0,1,10,1" Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="{Binding TimeText}" FontSize="11.5" Foreground="{StaticResource InkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Location}" FontSize="11.5" Foreground="{StaticResource InkMutedBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Field label in forms. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Multi-line text area. -->
    <Style x:Key="TextArea" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="76" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource InkMutedBrush}"
                                       Visibility="Collapsed" IsHitTestVisible="False" Margin="2,0,0,0" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette taken from the logo: warm near-black ink on white, with the flamingo pink accent. -->
    <Color x:Key="InkColor">#2B1720</Color>
    <Color x:Key="InkSecondaryColor">#5E4A53</Color>
    <Color x:Key="InkMutedColor">#9A8890</Color>
    <Color x:Key="AccentColor">#D45D79</Color>
    <Color x:Key="AccentHoverColor">#C04866</Color>
    <Color x:Key="AccentPressedColor">#A93A56</Color>
    <Color x:Key="AccentSoftColor">#FCE9EE</Color>
    <Color x:Key="AccentSofterColor">#FEF5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FDFAFB</Color>
    <Color x:Key="SurfaceSunkenColor">#F7F0F2</Color>
    <Color x:Key="BorderColor">#F1E6EA</Color>
    <Color x:Key="BorderStrongColor">#E6D3DA</Color>
    <Color x:Key="DangerColor">#C42B4B</Color>
    <Color x:Key="DangerSoftColor">#FCEBEF</Color>
    <Color x:Key="ShadowColor">#4A1A2A</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentSofterBrush" Color="{StaticResource AccentSofterColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <!-- openNotes integration colour (openNotes' own violet) and priority colours of synced notes -->
    <SolidColorBrush x:Key="OpenNotesBrush" Color="#5B3E96" />
    <SolidColorBrush x:Key="PriorityHighBrush" Color="#E0434F" />
    <SolidColorBrush x:Key="PriorityMediumBrush" Color="#F0B429" />
    <SolidColorBrush x:Key="PriorityLowBrush" Color="#8B6BD6" />
    <SolidColorBrush x:Key="NowLineBrush" Color="#E0434F" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#EBCFD7" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#DDA9B7" />

    <!-- Inter (SIL OFL 1.1) is embedded; Segoe UI is the fallback. -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Icon glyphs ship with Windows 10 (MDL2) and Windows 11 (Fluent). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="CardShadow" Color="{StaticResource ShadowColor}" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.14" />
    <DropShadowEffect x:Key="SoftShadow" Color="{StaticResource ShadowColor}" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.10" />
</ResourceDictionary>

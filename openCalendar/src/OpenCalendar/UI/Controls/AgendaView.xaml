<UserControl x:Class="OpenCalendar.UI.Controls.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,16,28,24">
            <ItemsControl ItemsSource="{Binding AgendaDays}" MaxWidth="820" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Header" Text="{Binding Header}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkBrush}" Margin="0,8,16,0" />
                            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="6">
                                <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource AgendaEntryTemplate}" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Header" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsAgendaEmpty, Converter={StaticResource BoolToVis}}">
            <Image Source="/Assets/logo.png" Width="150" Height="150" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Nincs esemény a következő 60 napban" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,4" />
            <TextBlock Text="Kattints az „Új esemény” gombra, vagy kattints duplán a naptárban." Style="{StaticResource CaptionText}"
                       FontSize="13" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>

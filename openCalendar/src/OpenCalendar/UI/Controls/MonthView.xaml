<UserControl x:Class="OpenCalendar.UI.Controls.MonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Weekday header -->
        <ItemsControl ItemsSource="{Binding WeekdayHeaders}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource SectionLabel}" FontSize="11.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 6 × 7 day cells -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthCells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Cell" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="6,5,6,4"
                            Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="OnCellMouseDown" ClipToBounds="True">
                        <DockPanel>
                            <!-- Day number (today = filled pink circle) -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,3">
                                <Border x:Name="NumberBg" HorizontalAlignment="Left" MinWidth="24" Height="24" CornerRadius="12" Padding="6,0"
                                        Background="Transparent">
                                    <TextBlock x:Name="Number" Text="{Binding DayNumber}" FontSize="12.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                                </Border>
                            </Grid>

                            <Button DockPanel.Dock="Bottom" Style="{StaticResource BareButton}" HorizontalAlignment="Left" Cursor="Hand"
                                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ShowDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding MoreText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="4,1" />
                            </Button>

                            <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource MonthEntryTemplate}" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                            <Setter TargetName="Cell" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            <Setter TargetName="Number" Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="{StaticResource AccentSofterBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="NumberBg" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Number" Property="Foreground" Value="White" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>

<UserControl x:Class="OpenCalendar.UI.Controls.MiniCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: MiniCalendarViewModel -->
    <StackPanel>
        <Grid Margin="4,0,0,6">
            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE76B;"
                        Command="{Binding PreviousMonthCommand}" ToolTip="Előző hónap" />
                <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE76C;"
                        Command="{Binding NextMonthCommand}" ToolTip="Következő hónap" />
            </StackPanel>
        </Grid>

        <UniformGrid Columns="7" Margin="0,0,0,2">
            <TextBlock Text="H" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
            <TextBlock Text="K" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
            <TextBlock Text="Sze" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
            <TextBlock Text="Cs" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
            <TextBlock Text="P" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
            <TextBlock Text="Szo" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
            <TextBlock Text="V" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
        </UniformGrid>

        <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button x:Name="DayButton" Style="{StaticResource MiniDayButton}"
                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <Grid>
                            <Ellipse x:Name="Mark" Width="27" Height="27" Fill="Transparent" />
                            <TextBlock x:Name="Number" Text="{Binding Day}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource InkBrush}" />
                            <Ellipse x:Name="Busy" Width="4" Height="4" Fill="{StaticResource AccentBrush}" VerticalAlignment="Bottom"
                                     HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="Hidden" />
                        </Grid>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                            <Setter TargetName="Number" Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasEntries}" Value="True">
                            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Mark" Property="Fill" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="Number" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="Number" Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="Mark" Property="Fill" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Number" Property="Foreground" Value="White" />
                            <Setter TargetName="Number" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="Busy" Property="Fill" Value="White" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

<UserControl x:Class="OpenCalendar.UI.Controls.WeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenCalendar.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: day names + all-day row. Right margin = vertical scrollbar width, so columns line up. -->
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="egész nap" Style="{StaticResource CaptionText}" FontSize="10.5" VerticalAlignment="Bottom"
                           HorizontalAlignment="Right" Margin="0,0,8,8" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding DayColumns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="{Binding DataContext.DayColumnCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="4,8,4,6" MinHeight="78">
                                <StackPanel>
                                    <Button Style="{StaticResource BareButton}" HorizontalAlignment="Center" Cursor="Hand" ToolTip="Napi nézet"
                                            Command="{Binding DataContext.ShowDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock x:Name="DayName" Text="{Binding DayName}" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                                            <Border x:Name="NumberBg" Width="34" Height="34" CornerRadius="17" Margin="0,3,0,0" Background="Transparent">
                                                <TextBlock x:Name="Number" Text="{Binding DayNumber}" FontSize="17" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding AllDay}" ItemTemplate="{StaticResource AllDayEntryTemplate}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="NumberBg" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Number" Property="Foreground" Value="White" />
                                    <Setter TargetName="DayName" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Body: hour grid with timed entries -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <Grid Height="{x:Static controls:WeekView.GridHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Hour labels -->
                <ItemsControl ItemsSource="{Binding Hours}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="{x:Static controls:WeekView.HourHeight}">
                                <TextBlock Text="{Binding StringFormat={}{0:00}:00}" Style="{StaticResource CaptionText}" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,8,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Column="1">
                    <!-- Work hours tint -->
                    <Border VerticalAlignment="Top" Background="{StaticResource AccentSofterBrush}" Opacity="0.55"
                            Margin="{Binding WorkdayTop, Converter={StaticResource TopMargin}}" Height="{Binding WorkdayHeight}" />

                    <!-- Hour lines -->
                    <ItemsControl ItemsSource="{Binding Hours}" IsHitTestVisible="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="{x:Static controls:WeekView.HourHeight}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <Border BorderBrush="#F7EFF2" BorderThickness="0,0,0,1" Height="{x:Static controls:WeekView.HalfHourHeight}" VerticalAlignment="Top" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Day columns -->
                    <ItemsControl ItemsSource="{Binding DayColumns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="{Binding DataContext.DayColumnCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" MouseLeftButtonDown="OnColumnMouseDown" ToolTip="Dupla kattintás: új esemény">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" IsHitTestVisible="False" />

                                    <ItemsControl ItemsSource="{Binding Timed}" ItemTemplate="{StaticResource TimedEntryTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:DayEventsPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="controls:DayEventsPanel.StartMinute" Value="{Binding StartMinute}" />
                                                <Setter Property="controls:DayEventsPanel.EndMinute" Value="{Binding EndMinute}" />
                                                <Setter Property="controls:DayEventsPanel.Column" Value="{Binding Column}" />
                                                <Setter Property="controls:DayEventsPanel.ColumnCount" Value="{Binding ColumnCount}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>

                                    <!-- "Now" line -->
                                    <Canvas IsHitTestVisible="False" Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}">
                                        <Grid Canvas.Top="{Binding NowMinute, Converter={StaticResource MinuteToPixel}}"
                                              Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Margin="-4,-4,0,0">
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource NowLineBrush}" HorizontalAlignment="Left" />
                                            <Rectangle Height="2" Fill="{StaticResource NowLineBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </Canvas>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

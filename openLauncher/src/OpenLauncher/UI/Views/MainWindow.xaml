<Window x:Class="OpenLauncher.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenLauncher.UI.ViewModels"
        Title="openLauncher"
        Width="1180" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/openLauncher.ico"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource InkBrush}"
        Background="{StaticResource SurfaceAltBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Launch button painted in the app's own accent colour (Background is bound per card). -->
        <Style x:Key="AppAccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AppState.Installed}">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AppState.Portable}">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AppState.Installed}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AppState.Portable}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        </Style>

        <DataTemplate x:Key="AppCardTemplate" DataType="{x:Type vm:AppCardViewModel}">
            <Border Width="340" Margin="0,0,20,20" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14"
                    Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Accent strip in the app's colour -->
                    <Border CornerRadius="14,14,0,0" Background="{Binding Definition.AccentColor, Converter={StaticResource HexToBrush}}" />

                    <!-- Header: icon, name, tagline, menu -->
                    <Grid Grid.Row="1" Margin="20,18,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Definition.IconUri}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Definition.Name}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding Definition.Tagline}" FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{Binding Definition.AccentColor, Converter={StaticResource HexToBrush}}" FontWeight="Medium" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE712;" VerticalAlignment="Top"
                                ToolTip="További műveletek" Click="OnCardMenuClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Indítás" Tag="&#xE768;" Command="{Binding LaunchCommand}" />
                                    <MenuItem Header="Telepítés" Tag="&#xE896;" Command="{Binding InstallCommand}" />
                                    <MenuItem Header="Frissítés" Tag="&#xE777;" Command="{Binding UpdateCommand}" />
                                    <MenuItem Header="Újratelepítés / javítás" Tag="&#xE90F;" Command="{Binding RepairCommand}" />
                                    <MenuItem Header="Telepítési mappa megnyitása" Tag="&#xE838;" Command="{Binding OpenFolderCommand}" />
                                    <Separator />
                                    <MenuItem Header="Eltávolítás" Tag="&#xE74D;" Style="{StaticResource DangerMenuItem}" Command="{Binding UninstallCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- Description + status -->
                    <StackPanel Grid.Row="2" Margin="20,14,20,0">
                        <TextBlock Text="{Binding Definition.Description}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource InkSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Style="{StaticResource StatusChip}">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusChipText}" />
                            </Border>
                            <Border Style="{StaticResource StatusChip}" Margin="6,0,0,0" Background="{StaticResource AccentSoftBrush}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Fut" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   Visibility="{Binding HintText, Converter={StaticResource NotNullToVis}}" />
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Margin="20,18,20,20">
                        <Grid Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Launch (installed / portable) -->
                            <Button Style="{StaticResource AppAccentButton}" Content="Indítás" Tag="&#xE768;"
                                    Background="{Binding Definition.AccentColor, Converter={StaticResource HexToBrush}}"
                                    Command="{Binding LaunchCommand}"
                                    Visibility="{Binding Status.CanLaunch, Converter={StaticResource BoolToVis}}" />
                            <!-- Install (not installed) -->
                            <Button Style="{StaticResource AppAccentButton}" Content="Telepítés" Tag="&#xE896;"
                                    Background="{Binding Definition.AccentColor, Converter={StaticResource HexToBrush}}"
                                    Command="{Binding InstallCommand}"
                                    Visibility="{Binding Status.CanLaunch, Converter={StaticResource InverseBoolToVis}}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="Frissítés" Command="{Binding UpdateCommand}"
                                        Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Eltávolítás" Command="{Binding UninstallCommand}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BusyText}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ProgressBar Style="{StaticResource ThinProgress}"
                                         Foreground="{Binding Definition.AccentColor, Converter={StaticResource HexToBrush}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════ Title bar ═══════════ -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/icon.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="open" FontSize="17" FontWeight="Bold" Margin="10,0,0,1" VerticalAlignment="Center" />
                    <TextBlock Text="Launcher" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,1" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Állapot frissítése  (F5)" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeClick" ToolTip="Kis méret" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximizeClick" ToolTip="Teljes méret" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="Bezárás" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ App tiles ═══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,32,20,12">
                <TextBlock Text="Alkalmazások" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="{Binding SummaryText}" FontSize="13" Foreground="{StaticResource InkMutedBrush}" Margin="0,4,0,24" />
                <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppCardTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════ Footer ═══════════ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="30,8,20,8">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE838;" Content="Telepítők mappája" Command="{Binding OpenInstallersFolderCommand}" />
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE9F9;" Content="Naplók" Command="{Binding OpenLogFolderCommand}" Margin="4,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{StaticResource InkMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="OpenNotes.UI.Views.ReminderSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teendők – openNotes"
        Width="500" Height="600" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Icon="/Assets/openNotes.ico"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource InkBrush}"
        Background="{StaticResource SurfaceBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="80" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,18,10,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xEA8F;" Style="{StaticResource IconGlyph}" FontSize="19" Foreground="{StaticResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Hátralévő teendők" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="{Binding TodayHeaderText}" Style="{StaticResource CaptionText}" FontSize="12.5" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ReminderCountsText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Height="36" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick" ToolTip="Bezárás (Esc)" />
            </Grid>
        </Border>

        <!-- Groups -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12,18,12">
            <StackPanel>
                <StackPanel Visibility="{Binding HasOverdue, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Margin="6,4,0,6">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="LEJÁRT" Style="{StaticResource SectionLabel}" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding OverdueReminders}" ItemTemplate="{StaticResource ReminderRowTemplate}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasToday, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Margin="6,4,0,6">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="MA ESEDÉKES" Style="{StaticResource SectionLabel}" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TodayReminders}" ItemTemplate="{StaticResource ReminderRowTemplate}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasUpcoming, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="6,4,0,6">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource InkMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="KÖZELGŐ" Style="{StaticResource SectionLabel}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding UpcomingReminders}" ItemTemplate="{StaticResource ReminderRowTemplate}" />
                </StackPanel>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" Margin="0,60,0,0"
                            Visibility="{Binding HasReminders, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" FontSize="26" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="Minden teendő kész!" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock Text="Állíts be határidőt és emlékeztetőt egy jegyzethez a főablakban." Style="{StaticResource CaptionText}"
                               FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <TextBlock Text="Kattints egy teendőre a megnyitáshoz, a körre a lezáráshoz." Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,140,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Rendben" HorizontalAlignment="Right" Click="OnCloseClick" IsDefault="True" />
            </Grid>
        </Border>
    </Grid>
</Window>

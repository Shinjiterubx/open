<Window x:Class="OpenNotes.UI.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenNotes.UI.Controls"
        Title="openNotes – mini"
        Width="420" Height="540" MinWidth="320" MinHeight="300"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Icon="/Assets/openNotes.ico"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource InkBrush}"
        Background="{StaticResource SurfaceBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewNoteCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveNowCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding ToggleMiniModeCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Header: drag area + quick actions -->
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="/Assets/icon.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />

                <TextBox x:Name="TitleBox" Grid.Column="1" Style="{StaticResource TitleBox}" FontSize="14.5" FontWeight="SemiBold"
                         TextWrapping="NoWrap" Margin="10,0,8,0" VerticalAlignment="Center" Tag="Cím nélkül"
                         WindowChrome.IsHitTestVisibleInChrome="True"
                         Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton x:Name="PreviewToggle" Style="{StaticResource IconToggleButton}" Content="&#xE890;" ToolTip="Előnézet" />
                    <ToggleButton Style="{StaticResource IconToggleButton}" Content="&#xE718;" ToolTip="Mindig felül"
                                  IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13" Content="&#xE710;"
                            Command="{Binding NewNoteCommand}" ToolTip="Új jegyzet  (Ctrl+N)" />
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13" Content="&#xE740;"
                            Command="{Binding ToggleMiniModeCommand}" ToolTip="Teljes nézet  (Ctrl+M)" />
                    <Button Style="{StaticResource CaptionCloseButton}" Width="36" Height="32" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="Elrejtés  (Esc)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <controls:MarkdownEditor x:Name="NoteEditor" CompactToolbar="True" EditorPadding="18,14,14,40"
                                     Visibility="{Binding IsChecked, ElementName=PreviewToggle, Converter={StaticResource InverseBoolToVis}}"
                                     IsEnabled="{Binding Editor.HasNote}"
                                     Text="{Binding Editor.Content, UpdateSourceTrigger=PropertyChanged}"
                                     DocumentKey="{Binding Editor.NoteId}"
                                     AssetSink="{Binding Editor}"
                                 AssetSource="{Binding Editor}"
                                 OpenImageCommand="{Binding OpenImageCommand}"
                                 InlineImageMaxHeight="220"
                                     ImportFilesCommand="{Binding ImportFilesCommand}"
                                     EditorFontSize="{Binding EditorFontSize}" />

            <controls:MarkdownPreview Compact="True"
                                      Visibility="{Binding IsChecked, ElementName=PreviewToggle, Converter={StaticResource BoolToVis}}"
                                      Html="{Binding Editor.PreviewHtml}"
                                      ToggleTaskCommand="{Binding Editor.ToggleTaskCommand}"
                                  OpenImageCommand="{Binding OpenImageCommand}"
                                      ContentFontSize="{Binding EditorFontSize}" />
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
                    <Run Text="{Binding Editor.WordCount, Mode=OneWay}" /><Run Text=" szó" />
                </TextBlock>
                <TextBlock Text="{Binding Editor.SaveStatus}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

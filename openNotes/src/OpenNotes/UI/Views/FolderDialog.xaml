<Window x:Class="OpenNotes.UI.Views.FolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Colour swatch: the colour is the RadioButton's Tag (hex string). -->
        <Style x:Key="FolderSwatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="30" Height="30">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource InkBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse Margin="4" Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexToBrush}}" />
                            <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource IconGlyph}" FontSize="11" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="{StaticResource SurfaceBrush}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource CardShadow}" MouseLeftButtonDown="OnDragArea">
        <StackPanel Margin="26,24,26,22">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="White" />
                </Border>
                <TextBlock x:Name="TitleText" FontSize="16.5" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Név" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkSecondaryBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Tag="pl. Munka, Otthon, Egyetem" MaxLength="60"
                     TextChanged="OnNameChanged" />

            <TextBlock Text="Szín" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkSecondaryBrush}" Margin="0,16,0,8" />
            <WrapPanel x:Name="Swatches" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Mégse" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="OpenNotes.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenNotes.UI.Controls"
        xmlns:models="clr-namespace:OpenNotes.Core.Models"
        Title="Beállítások – openNotes"
        Width="600" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Icon="/Assets/openNotes.ico"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource InkBrush}"
        Background="{StaticResource SurfaceAltBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="26,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                <TextBlock Text="Beállítások" FontSize="18" FontWeight="Bold" />
            </StackPanel>
            <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Height="40" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancelClick" ToolTip="Bezárás (Esc)" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,4,26,10">
            <StackPanel>
                <!-- Hotkeys -->
                <TextBlock Text="GYORSBILLENTYŰK" Style="{StaticResource SectionLabel}" Margin="2,6,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Rendszerszintű billentyűkombinációk – akkor is működnek, ha az openNotes a háttérben fut. Kattints a mezőbe, majd nyomd le az új kombinációt."
                                   TextWrapping="Wrap" Foreground="{StaticResource InkSecondaryBrush}" FontSize="12.5" LineHeight="19" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Legutóbbi jegyzet megnyitása" FontSize="13.5" FontWeight="Medium" />
                                <TextBlock Text="Újbóli megnyomás elrejti a gyors ablakot" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <controls:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding OpenLastNoteHotkey}" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Új jegyzet létrehozása" FontSize="13.5" FontWeight="Medium" />
                                <TextBlock Text="Azonnal írhatsz bele" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <controls:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding NewNoteHotkey}" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Megnyitás helye" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SegmentedHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="HotkeyTarget" Content="Mini ablak"
                                                 IsChecked="{Binding HotkeyTarget, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:HotkeyTarget.MiniWindow}}" />
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="HotkeyTarget" Content="Főablak"
                                                 IsChecked="{Binding HotkeyTarget, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:HotkeyTarget.MainWindow}}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button Style="{StaticResource GhostButton}" Tag="&#xE777;" Content="Alapértelmezett kombinációk visszaállítása"
                                HorizontalAlignment="Left" Margin="-10,0,0,0" Command="{Binding ResetHotkeysCommand}" />
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Text="ÁLTALÁNOS" Style="{StaticResource SectionLabel}" Margin="2,6,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Margin="0,2,0,14">
                            <StackPanel>
                                <TextBlock Text="Indítás a Windows-zal" FontWeight="Medium" />
                                <TextBlock Text="Ajánlott, hogy a gyorsbillentyűk mindig elérhetők legyenek" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimized}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Indítás a háttérben" FontWeight="Medium" />
                                <TextBlock Text="Csak a tálcaikon jelenik meg induláskor" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray}" Margin="0,0,0,2">
                            <StackPanel>
                                <TextBlock Text="Bezáráskor a tálcára" FontWeight="Medium" />
                                <TextBlock Text="A bezárás gomb csak elrejti az ablakot; kilépés a tálcaikonról" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Reminders -->
                <TextBlock Text="EMLÉKEZTETŐK" Style="{StaticResource SectionLabel}" Margin="2,6,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DailySummaryEnabled}" Margin="0,2,0,14">
                            <StackPanel>
                                <TextBlock Text="Napi teendő-összegző" FontWeight="Medium" />
                                <TextBlock Text="A nap első indulásakor és a megadott időpontban megmutatja a hátralévő teendőket"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Grid>
                            <TextBlock Text="Napi emlékeztető időpontja" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource InputBox}" Width="90" HorizontalAlignment="Right" TextAlignment="Center"
                                     Tag="09:00" Text="{Binding DailySummaryTimeText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding DailySummaryEnabled}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Editor -->
                <TextBlock Text="SZERKESZTŐ" Style="{StaticResource SectionLabel}" Margin="2,6,0,8" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <TextBlock Text="Betűméret" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE738;" Command="{Binding DecreaseFontSizeCommand}" ToolTip="Kisebb" />
                            <TextBlock Text="{Binding FontSizeText}" Width="56" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" Command="{Binding IncreaseFontSizeCommand}" ToolTip="Nagyobb" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Storage -->
                <TextBlock Text="TÁRHELY" Style="{StaticResource SectionLabel}" Margin="2,6,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="A jegyzetek .openNote fájlként, ebben a mappában vannak:" Foreground="{StaticResource InkSecondaryBrush}" FontSize="12.5" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,10,0">
                                <TextBlock Text="{Binding NotesDirectory}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding NotesDirectory}" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Megnyitás" Command="{Binding OpenNotesFolderCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- About -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
                    <Image Source="/Assets/icon.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <Grid>
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                           FontSize="12.5" Margin="0,0,16,0" MaxWidth="300" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="Mégse" Margin="0,0,10,0" Click="OnCancelClick" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Mentés" IsDefault="True" Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette taken from the logo: deep ink purple on white, with a violet accent. -->
    <Color x:Key="InkColor">#1A0E2F</Color>
    <Color x:Key="InkSecondaryColor">#544A63</Color>
    <Color x:Key="InkMutedColor">#8C849A</Color>
    <Color x:Key="AccentColor">#5B3E96</Color>
    <Color x:Key="AccentHoverColor">#4B2F84</Color>
    <Color x:Key="AccentPressedColor">#3D2470</Color>
    <Color x:Key="AccentSoftColor">#EFE9FA</Color>
    <Color x:Key="AccentSofterColor">#F7F4FC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FAF9FC</Color>
    <Color x:Key="SurfaceSunkenColor">#F2EFF7</Color>
    <Color x:Key="BorderColor">#ECE8F2</Color>
    <Color x:Key="BorderStrongColor">#DAD3E6</Color>
    <Color x:Key="DangerColor">#C42B4B</Color>
    <Color x:Key="DangerSoftColor">#FCEBEF</Color>
    <Color x:Key="ShadowColor">#2A1A4A</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentSofterBrush" Color="{StaticResource AccentSofterColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <!-- Priority colours: high = red, medium = yellow, low = purple -->
    <SolidColorBrush x:Key="PriorityHighBrush" Color="#E0434F" />
    <SolidColorBrush x:Key="PriorityMediumBrush" Color="#F0B429" />
    <SolidColorBrush x:Key="PriorityLowBrush" Color="#8B6BD6" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#D6CEE4" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#B9ACD0" />

    <!-- Inter (SIL OFL 1.1) is embedded; Segoe UI is the fallback. -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Icon glyphs ship with Windows 10 (MDL2) and Windows 11 (Fluent). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="CardShadow" Color="{StaticResource ShadowColor}" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.14" />
    <DropShadowEffect x:Key="SoftShadow" Color="{StaticResource ShadowColor}" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.10" />
</ResourceDictionary>

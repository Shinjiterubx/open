<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only used for the system tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>openNotes</AssemblyName>
    <RootNamespace>OpenNotes</RootNamespace>
    <ApplicationIcon>Assets\openNotes.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.0.0</Version>
    <Product>openNotes</Product>
    <Company>openNotes contributors</Company>
    <Authors>Szegedi Tamás and contributors</Authors>
    <Copyright>Copyright © 2026 Szegedi Tamás and contributors</Copyright>
    <Description>openNotes – open source Markdown note taking app for Windows.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon; keep its namespaces out of the global scope
         so they never clash with WPF types (Application, MessageBox, Button...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- The WPF SDK leaves System.IO out of the implicit usings (Path clashes with Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF resources (window icon, logo, embedded Inter font). -->
    <Resource Include="Assets\openNotes.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Fonts\*.otf" />

    <!-- Preview (WebView2) web root: shell page, stylesheet and the same Inter font files. -->
    <Content Include="Web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\*.otf" Link="Web\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <EmbeddedResource Include="UI\Editing\MarkdownHighlighting.xshd" />

    <!-- Licenses shipped next to the exe. -->
    <None Update="Assets\Fonts\OFL.txt" Link="licenses\Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="licenses\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="licenses\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenNotes.Tests" />
  </ItemGroup>

</Project>

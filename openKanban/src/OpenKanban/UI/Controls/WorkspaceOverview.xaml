<UserControl x:Class="OpenKanban.UI.Controls.WorkspaceOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: MainViewModel; shows SelectedWorkspace's boards as tiles -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,28,36,28">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <!-- Workspace header -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="14" Margin="0,0,16,0"
                        Background="{Binding SelectedWorkspace.Color, Converter={StaticResource HexToBrush}}">
                    <TextBlock Text="{Binding SelectedWorkspace.Initial}" FontSize="24" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedWorkspace.Name}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectedWorkspace.Description}" FontSize="13" Foreground="{StaticResource InkSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding SelectedWorkspace.Description, Converter={StaticResource NotNullToVis}}" />
                    <TextBlock Text="{Binding SelectedWorkspace.Summary}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,0" Command="{Binding EditWorkspaceCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Szerkesztés" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Padding="12,7" Command="{Binding ExportWorkspaceCommand}"
                            ToolTip="Teljes workspace mentése .openKanban fájlba">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Exportálás" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Text="TÁBLÁK" Style="{StaticResource SectionLabel}" Margin="2,0,0,10" />

            <WrapPanel>
                <ItemsControl ItemsSource="{Binding SelectedWorkspace.Boards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Tile" Style="{StaticResource BareButton}" Width="236" Height="128" Margin="0,0,14,14"
                                    Command="{Binding DataContext.OpenBoardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Border x:Name="TileBorder" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Background="{StaticResource SurfaceBrush}" Effect="{StaticResource SoftShadow}" ClipToBounds="True">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Height="54" CornerRadius="11,11,0,0"
                                                Background="{Binding Background, Converter={StaticResource HexToBrush}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,8" Opacity="0.75">
                                                <Rectangle Width="26" Height="30" RadiusX="3" RadiusY="3" Fill="White" Margin="0,0,4,0" />
                                                <Rectangle Width="26" Height="22" RadiusX="3" RadiusY="3" Fill="White" Margin="0,0,4,0" VerticalAlignment="Top" />
                                                <Rectangle Width="26" Height="14" RadiusX="3" RadiusY="3" Fill="White" VerticalAlignment="Top" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="14,10,14,10">
                                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource BareButton}" Width="236" Height="128" Margin="0,0,14,14" Command="{Binding NewBoardCommand}">
                    <Border CornerRadius="12" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1.5" Background="{StaticResource SurfaceAltBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Új tábla" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

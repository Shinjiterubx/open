<UserControl x:Class="OpenKanban.UI.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="Swatches">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <RadioButton Style="{StaticResource SwatchRadio}" Tag="{Binding}" GroupName="{Binding GroupName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Width="{Binding SwatchSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Height="{Binding SwatchSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Checked="OnSwatchChecked" Loaded="OnSwatchLoaded" ToolTip="{Binding}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

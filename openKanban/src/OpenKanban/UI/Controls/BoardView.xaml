<UserControl x:Class="OpenKanban.UI.Controls.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenKanban.UI.Controls"
             xmlns:boards="clr-namespace:OpenKanban.Core.Boards">
    <!-- DataContext: MainViewModel -->
    <UserControl.Resources>

        <!-- ───────────── Card ───────────── -->
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="CardRoot" Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand" Effect="{StaticResource SoftShadow}"
                    PreviewMouseLeftButtonDown="OnCardMouseDown" PreviewMouseMove="OnCardMouseMove" PreviewMouseLeftButtonUp="OnCardMouseUp"
                    ToolTip="Kattintás: részletek · Húzás: áthelyezés">
                <Grid>
                    <StackPanel>
                        <!-- Cover -->
                        <Border Height="26" CornerRadius="9,9,0,0" Background="{Binding CoverColor, Converter={StaticResource HexToBrush}}"
                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Margin="11,9,11,10">
                            <!-- Labels -->
                            <ItemsControl ItemsSource="{Binding Labels}" Margin="0,0,0,6"
                                          Visibility="{Binding HasLabels, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="7,1" Margin="0,0,4,4" MinWidth="34" MinHeight="8"
                                                Background="{Binding Color, Converter={StaticResource HexToBrush}}" ToolTip="{Binding Name}">
                                            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                                       Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="CardTitle" Text="{Binding Title}" FontSize="13.5" FontWeight="Medium" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkBrush}" Margin="0,0,22,0" LineHeight="19" />

                            <!-- Badges -->
                            <WrapPanel Margin="0,8,0,0" Visibility="{Binding HasBadges, Converter={StaticResource BoolToVis}}">
                                <Border CornerRadius="6" Padding="6,2" Margin="0,0,6,2"
                                        Background="{Binding DueState, Converter={StaticResource DueSoftBrush}}"
                                        Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}" ToolTip="Határidő">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="10.5" Margin="0,1,5,0"
                                                   Foreground="{Binding DueState, Converter={StaticResource DueBrush}}" />
                                        <TextBlock Text="{Binding DueText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding DueState, Converter={StaticResource DueBrush}}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ChecklistBadge" CornerRadius="6" Padding="6,2" Margin="0,0,6,2" Background="{StaticResource SurfaceSunkenBrush}"
                                        Visibility="{Binding HasChecklist, Converter={StaticResource BoolToVis}}" ToolTip="Ellenőrzőlista">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ChecklistIcon" Text="&#xE73A;" FontFamily="{StaticResource IconFont}" FontSize="10.5" Margin="0,1,5,0"
                                                   Foreground="{StaticResource InkSecondaryBrush}" />
                                        <TextBlock x:Name="ChecklistText" Text="{Binding ChecklistText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="&#xE8A4;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="2,3,8,0"
                                           Foreground="{StaticResource InkMutedBrush}" ToolTip="Van leírása"
                                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource BareButton}" Margin="0,1,0,0" ToolTip="Kapcsolt jegyzet megnyitása az openNotes-ban"
                                        Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.OpenCardNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Border CornerRadius="6" Padding="6,2" Background="#EFE9FA">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="10.5" Margin="0,1,5,0" Foreground="#5B3E96" />
                                            <TextBlock Text="Jegyzet" FontSize="11.5" FontWeight="SemiBold" Foreground="#5B3E96" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Done toggle (top-right, shown on hover or when done) -->
                    <Button x:Name="DoneButton" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                            Style="{StaticResource BareButton}" Visibility="Hidden" ToolTip="Kész / nincs kész"
                            Command="{Binding DataContext.ToggleCardDoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Grid>
                            <Ellipse x:Name="DoneRing" Fill="{StaticResource SurfaceBrush}" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1.6" />
                            <TextBlock x:Name="DoneCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="DoneButton" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsChecklistComplete}" Value="True">
                    <Setter TargetName="ChecklistBadge" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter TargetName="ChecklistIcon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="ChecklistText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="DoneButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DoneRing" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="DoneRing" Property="Stroke" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="DoneCheck" Property="Visibility" Value="Visible" />
                    <Setter TargetName="CardTitle" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="CardTitle" Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDone}" Value="True" />
                        <Condition Binding="{Binding DataContext.FadeDoneCards, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="CardRoot" Property="Opacity" Value="0.62" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ───────────── Column ───────────── -->
        <DataTemplate x:Key="ColumnTemplate">
            <Border x:Name="ColumnRoot" Width="{Binding DataContext.ColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Margin="0,0,12,0" VerticalAlignment="Top" CornerRadius="12" Background="#EEF2F7"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource Subtract}, ConverterParameter=30}"
                    AllowDrop="True" DragOver="OnColumnDragOver" DragLeave="OnColumnDragLeave" Drop="OnColumnDrop">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="4" CornerRadius="11,11,0,0" Background="{Binding Color, Converter={StaticResource HexToBrush}}" />

                    <!-- Header (drag to reorder columns) -->
                    <Grid DockPanel.Dock="Top" Margin="12,8,6,6" Background="Transparent" Cursor="SizeAll"
                          PreviewMouseLeftButtonDown="OnColumnHeaderMouseDown" PreviewMouseMove="OnColumnHeaderMouseMove"
                          ToolTip="Húzd az oszlop áthelyezéséhez">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,1,6,0" VerticalAlignment="Center" ToolTip="Az ide kerülő kártyák „kész” állapotúak lesznek"
                                       Visibility="{Binding MarksDone, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="CountBadge" Grid.Column="1" CornerRadius="9" Padding="7,1" Margin="6,0,2,0" VerticalAlignment="Center"
                                Background="{StaticResource SurfaceBrush}" ToolTip="{Binding CountToolTip}">
                            <TextBlock x:Name="CountText" Text="{Binding CountText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkSecondaryBrush}" />
                        </Border>
                        <Button x:Name="ColumnMenuButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE712;"
                                ToolTip="Oszlop műveletek" Tag="{Binding}" Click="OnColumnMenuClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Kártya hozzáadása" Tag="&#xE710;" Command="{Binding OpenComposerCommand}"
                                              CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Oszlop beállításai (név, szín, korlát)…" Tag="&#xE70F;" Command="{Binding EditColumnCommand}"
                                              CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Oszlop törlése" Tag="&#xE74D;" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteColumnCommand}"
                                              CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- Footer: composer / add button -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,8">
                        <Button Style="{StaticResource GhostButton}" Tag="&#xE710;" Content="Kártya hozzáadása" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Visibility="{Binding IsComposerOpen, Converter={StaticResource InverseBoolToVis}}"
                                Command="{Binding DataContext.OpenComposerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <StackPanel Visibility="{Binding IsComposerOpen, Converter={StaticResource BoolToVis}}">
                            <TextBox Style="{StaticResource TextArea}" MinHeight="58" Tag="Kártya címe… (Enter: hozzáadás, Esc: bezárás)"
                                     AcceptsReturn="False" Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                     controls:FocusBehavior.IsFocused="{Binding IsComposerOpen}" PreviewKeyDown="OnComposerKeyDown" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Hozzáadás" Padding="12,6"
                                        Command="{Binding DataContext.AddCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,0,0,0" ToolTip="Bezárás (Esc)"
                                        Command="{Binding DataContext.CloseComposerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,2,8,2">
                        <StackPanel>
                            <ItemsControl x:Name="CardsHost" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" MinHeight="8" />
                            <TextBlock Text="{Binding HiddenCount, StringFormat='{}{0} kártya rejtve (szűrés)'}" Margin="4,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HiddenCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFull}" Value="True">
                    <Setter TargetName="CountBadge" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                    <Setter TargetName="CountBadge" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                    <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{Binding CurrentBoard.Background, Converter={StaticResource HexToBrush}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Board header (on a light panel, so it reads well on any board background) -->
        <Border Margin="20,14,20,12" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16,10,12,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Effect="{StaticResource SoftShadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="BoardWorkspace" Text="{Binding CurrentBoard.WorkspaceName}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource InkMutedBrush}" />
                <TextBlock x:Name="BoardTitle" Text="{Binding CurrentBoard.Name}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="BoardStatus" Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,0" Command="{Binding EditBoardCommand}"
                        ToolTip="Név, háttérszín, címkék">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Tábla beállításai" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Padding="12,7" Command="{Binding NewColumnCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="11" Margin="0,0,8,0" />
                        <TextBlock Text="Új oszlop" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Columns -->
        <ScrollViewer x:Name="BoardScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      PreviewDragOver="OnBoardPreviewDragOver">
            <StackPanel Orientation="Horizontal" Margin="20,0,20,14" VerticalAlignment="Top">
                <ItemsControl x:Name="ColumnsHost" ItemsSource="{Binding CurrentBoard.Columns}" ItemTemplate="{StaticResource ColumnTemplate}"
                              AllowDrop="True" DragOver="OnColumnsDragOver" DragLeave="OnColumnsDragLeave" Drop="OnColumnsDrop" Background="Transparent">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Button Style="{StaticResource BareButton}" VerticalAlignment="Top" Command="{Binding NewColumnCommand}"
                        Width="{Binding ColumnWidth}">
                    <Border x:Name="AddColumnTile" CornerRadius="12" Padding="14,12" Background="#66FFFFFF"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1.5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="Új oszlop hozzáadása" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

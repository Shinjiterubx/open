<Window x:Class="OpenKanban.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenKanban.UI.Controls"
        Title="openKanban"
        Width="1400" Height="860" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/openKanban.ico"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource InkBrush}"
        Background="{StaticResource SurfaceBrush}"
        UseLayoutRounding="True"
        AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewColumnCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ Title bar ═══════════ -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/icon.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="open" FontSize="17" FontWeight="Bold" Margin="10,0,0,1" VerticalAlignment="Center" />
                    <TextBlock Text="Kanban" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,1" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Search / filter (board open) -->
                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" Width="340" HorizontalAlignment="Center"
                         Tag="Kártyák szűrése a táblán  (Ctrl+F)" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         WindowChrome.IsHitTestVisibleInChrome="True"
                         Visibility="{Binding IsBoardOpen, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE8B5;" Content="Importálás" Command="{Binding ImportCommand}"
                            ToolTip="Workspace importálása .openKanban fájlból  (Ctrl+I)" />
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="4,0,0,0" ToolTip="További műveletek"
                            Click="OnMoreClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Új workspace…" Tag="&#xE710;" Command="{Binding NewWorkspaceCommand}" />
                                <MenuItem Header="Workspace exportálása…" Tag="&#xE898;" Command="{Binding ExportWorkspaceCommand}" />
                                <MenuItem Header="Workspace importálása…" Tag="&#xE8B5;" Command="{Binding ImportCommand}" />
                                <Separator />
                                <MenuItem Header="Adatmappa megnyitása" Tag="&#xE838;" Command="{Binding OpenDataFolderCommand}" />
                                <MenuItem Header="Beállítások" Tag="&#xE713;" Command="{Binding OpenSettingsCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}" ToolTip="Beállítások  (Ctrl+,)" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeClick" ToolTip="Kis méret" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximizeClick" ToolTip="Teljes méret" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="Bezárás" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Body ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="200" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: workspaces & boards -->
            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,16,10,8">
                        <TextBlock Text="WORKSPACE-EK" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE710;" HorizontalAlignment="Right"
                                Command="{Binding NewWorkspaceCommand}" ToolTip="Új workspace" />
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Tag="&#xE8B5;" Content="Importálás" Command="{Binding ImportCommand}" />
                            <Button Style="{StaticResource GhostButton}" Tag="&#xE838;" Content="Mappa" Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                        <ItemsControl ItemsSource="{Binding Workspaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <!-- Workspace row -->
                                        <Button x:Name="WsRow" Style="{StaticResource RowButton}" Padding="8,6"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.OpenWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="Jobb klikk: műveletek">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Új tábla" Tag="&#xE710;" Command="{Binding NewBoardCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Szerkesztés (név, szín, leírás)…" Tag="&#xE70F;" Command="{Binding EditWorkspaceCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Exportálás .openKanban fájlba…" Tag="&#xE898;" Command="{Binding ExportWorkspaceCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator />
                                                    <MenuItem Header="Workspace törlése" Tag="&#xE74D;" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteWorkspaceCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="12.5" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="WsName" Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                                                <Button Grid.Column="2" Width="24" Height="24" FontSize="10" ToolTip="Kinyitás / becsukás"
                                                        Command="{Binding DataContext.ToggleWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                            <Setter Property="Content" Value="&#xE76C;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Content" Value="&#xE70D;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Button>

                                        <!-- Boards -->
                                        <ItemsControl ItemsSource="{Binding Boards}" Margin="20,2,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button x:Name="BoardRow" Style="{StaticResource RowButton}" Padding="8,6"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Command="{Binding DataContext.OpenBoardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="Tábla beállításai…" Tag="&#xE713;" Command="{Binding EditBoardCommand}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="Duplikálás" Tag="&#xE8C8;" Command="{Binding DuplicateBoardCommand}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <Separator />
                                                                <MenuItem Header="Tábla törlése" Tag="&#xE74D;" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteBoardCommand}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="16" Height="12" CornerRadius="3" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                                    Background="{Binding Background, Converter={StaticResource HexToBrush}}" />
                                                            <TextBlock x:Name="BoardName" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource InkSecondaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="BoardRow" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                            <Setter TargetName="BoardName" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="BoardName" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Style="{StaticResource GhostButton}" Tag="&#xE710;" Content="Új tábla" Margin="20,0,0,0" HorizontalAlignment="Left"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.NewBoardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="WsName" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" Margin="-3,0,-2,0" Background="Transparent" ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" Focusable="False" Panel.ZIndex="1" />

            <!-- Content -->
            <Grid Grid.Column="2">
                <controls:BoardView Visibility="{Binding IsBoardOpen, Converter={StaticResource BoolToVis}}" />
                <controls:WorkspaceOverview Visibility="{Binding IsOverviewOpen, Converter={StaticResource BoolToVis}}" />

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasWorkspaces, Converter={StaticResource InverseBoolToVis}}">
                    <Image Source="/Assets/logo.png" Width="170" Height="170" Opacity="0.95" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Kezdj egy workspace-szel" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock Text="A workspace táblákat fog össze – például Munka, Otthon vagy egy projekt." Foreground="{StaticResource InkSecondaryBrush}"
                               FontSize="13.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Új workspace" Command="{Binding NewWorkspaceCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Importálás…" Command="{Binding ImportCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

<Window x:Class="OpenKanban.UI.Views.BoardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenKanban.UI.Controls"
        Width="560" Height="640" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource InkBrush}" UseLayoutRounding="True">
    <Border x:Name="Surface" Margin="18" Background="{StaticResource SurfaceBrush}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" Effect="{StaticResource CardShadow}">
        <DockPanel Margin="26,22,26,22">
            <TextBlock DockPanel.Dock="Top" Text="Tábla beállításai" FontSize="17" FontWeight="Bold" Margin="0,0,0,16" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Mégse" Margin="0,0,10,0" Click="OnCancel" />
                <Button Style="{StaticResource PrimaryButton}" Content="Mentés" Click="OnSave" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="Név" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameInput" Style="{StaticResource InputBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Text="Háttérszín" Style="{StaticResource FieldLabel}" />
                    <controls:ColorPicker Colors="{Binding Backgrounds}" SelectedColor="{Binding Background}" Margin="0,0,0,18" />

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Címkék" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0" />
                        <Button Style="{StaticResource GhostButton}" Tag="&#xE710;" Content="Új címke" HorizontalAlignment="Right" Command="{Binding AddLabelCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Labels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="22" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Height="32" Tag="Címke neve (lehet üres)"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Style="{StaticResource DangerIconButton}" Width="30" Height="30" FontSize="11" Content="&#xE74D;"
                                                    Margin="6,0,0,0" ToolTip="Címke törlése (a kártyákról is lekerül)"
                                                    Command="{Binding DataContext.RemoveLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                        <controls:ColorPicker Colors="{Binding Palette}" SelectedColor="{Binding Color}" SwatchSize="24" Margin="44,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>

<Window x:Class="OpenKanban.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beállítások – openKanban"
        Width="580" Height="600" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/openKanban.ico"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource InkBrush}" Background="{StaticResource SurfaceAltBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="26,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                <TextBlock Text="Beállítások" FontSize="18" FontWeight="Bold" />
            </StackPanel>
            <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Height="40" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancelClick" ToolTip="Bezárás (Esc)" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,4,26,10">
            <StackPanel>
                <TextBlock Text="TÁBLA" Style="{StaticResource SectionLabel}" Margin="2,6,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Oszlopszélesség" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Content="&#xE738;" Command="{Binding NarrowerCommand}" ToolTip="Keskenyebb" />
                                <TextBlock Text="{Binding ColumnWidthText}" Width="60" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE710;" Command="{Binding WiderCommand}" ToolTip="Szélesebb" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FadeDoneCards}">
                            <TextBlock Text="Kész kártyák halványítása" FontWeight="Medium" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="INTEGRÁCIÓ" Style="{StaticResource SectionLabel}" Margin="2,6,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OpenNotesIntegration}" Margin="0,2,0,14">
                            <StackPanel>
                                <TextBlock Text="openNotes – jegyzet kapcsolása kártyához" FontWeight="Medium" />
                                <TextBlock Text="{Binding NotesStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OpenCalendarIntegration}">
                            <StackPanel>
                                <TextBlock Text="openCalendar – határidők megjelenítése a naptárban" FontWeight="Medium" />
                                <TextBlock Text="{Binding CalendarStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="Az alkalmazások egymás nélkül is teljes értékűek – a kapcsolat csak akkor él, ha a másik is telepítve van."
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="TÁRHELY" Style="{StaticResource SectionLabel}" Margin="2,6,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="A workspace-ek .openKanban fájlként, ebben a mappában vannak:" Foreground="{StaticResource InkSecondaryBrush}" FontSize="12.5" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,10,0">
                                <TextBlock Text="{Binding WorkspacesDirectory}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding WorkspacesDirectory}" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Megnyitás" Command="{Binding OpenDataFolderCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
                    <Image Source="/Assets/icon.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Mégse" Margin="0,0,10,0" Click="OnCancelClick" />
                <Button Style="{StaticResource PrimaryButton}" Content="Mentés" IsDefault="True" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="OpenKanban.UI.Views.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenKanban.UI.Controls"
        Title="Kártya – openKanban"
        Width="760" Height="820" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/openKanban.ico"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource InkBrush}"
        Background="{StaticResource SurfaceBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cover + header -->
        <Grid>
            <Border Height="44" Background="{Binding CoverColor, Converter={StaticResource HexToBrush}}"
                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
            <Grid Height="44" Margin="26,0,0,0">
                <TextBlock Text="{Binding Breadcrumb}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCover}" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding CancelCommand}" ToolTip="Bezárás (Esc)" />
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,6,26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>

                <!-- ═══ Main column ═══ -->
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource CalendarCheck}" Tag="#2E8B57" IsChecked="{Binding IsDone}" VerticalAlignment="Top"
                                  Margin="-8,4,2,0" ToolTip="Kész" />
                        <TextBox x:Name="TitleInput" Grid.Column="1" Style="{StaticResource TitleBox}" FontSize="22" Tag="Kártya címe"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!-- Labels -->
                    <TextBlock Text="CÍMKÉK" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Labels}" Margin="0,0,0,4" Visibility="{Binding HasLabels, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsChecked}" Margin="0,0,6,6" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" CornerRadius="7" Padding="10,5" BorderThickness="2" BorderBrush="Transparent"
                                                    Background="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=soft}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,6,0"
                                                               Foreground="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=text}" Visibility="Collapsed" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=text}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=medium}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="A táblának még nincsenek címkéi – a Tábla beállításaiban adhatsz hozzá." Style="{StaticResource CaptionText}"
                               Margin="0,0,0,4" Visibility="{Binding HasLabels, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Description -->
                    <TextBlock Text="LEÍRÁS" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                    <TextBox Style="{StaticResource TextArea}" MinHeight="120" Tag="Részletek, linkek, teendők…"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Checklist -->
                    <Grid Margin="0,20,0,8">
                        <TextBlock Text="ELLENŐRZŐLISTA" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ChecklistProgressText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"
                                   Visibility="{Binding HasChecklist, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <ProgressBar Height="6" Maximum="100" Value="{Binding ChecklistProgress, Mode=OneWay}" Margin="0,0,0,10"
                                 Foreground="{StaticResource SuccessBrush}" Background="{StaticResource SurfaceSunkenBrush}" BorderThickness="0"
                                 Visibility="{Binding HasChecklist, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Checklist}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource CalendarCheck}" Tag="#2E8B57" IsChecked="{Binding IsDone}" Margin="-8,0,0,0" />
                                    <TextBox x:Name="ItemText" Grid.Column="1" Style="{StaticResource InputBox}" Height="32" BorderBrush="Transparent"
                                             Background="Transparent" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Style="{StaticResource DangerIconButton}" Width="28" Height="28" FontSize="11" Content="&#xE74D;"
                                            Command="{Binding DataContext.RemoveChecklistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="Tétel törlése" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewItemInput" Style="{StaticResource InputBox}" Tag="Új tétel… (Enter)"
                                 Text="{Binding NewChecklistText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Hozzáadás" Margin="8,0,0,0"
                                Command="{Binding AddChecklistItemCommand}" />
                    </Grid>
                </StackPanel>

                <!-- ═══ Side column ═══ -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="OSZLOP" Style="{StaticResource SectionLabel}" Margin="0,4,0,8" />
                    <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" Margin="0,0,0,18">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Text="  (tele)" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding IsFull, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="HATÁRIDŐ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <controls:DateField SelectedDate="{Binding DueDate}" Placeholder="Nincs határidő" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Időpont" VerticalAlignment="Center" Foreground="{StaticResource InkSecondaryBrush}" FontSize="12.5" />
                        <TextBox Style="{StaticResource InputBox}" Width="96" HorizontalAlignment="Right" TextAlignment="Center" Tag="óó:pp"
                                 Text="{Binding DueTimeText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding HasDue}" />
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource ChipButton}" Content="Ma" Command="{Binding SetDueInDaysCommand}" CommandParameter="0" Margin="0,0,4,4" />
                        <Button Style="{StaticResource ChipButton}" Content="Holnap" Command="{Binding SetDueInDaysCommand}" CommandParameter="1" Margin="0,0,4,4" />
                        <Button Style="{StaticResource ChipButton}" Content="1 hét" Command="{Binding SetDueInDaysCommand}" CommandParameter="7" Margin="0,0,4,4" />
                    </WrapPanel>
                    <Grid Margin="0,2,0,0" Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DueStatusText}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostButton}" Content="Törlés" HorizontalAlignment="Right" Command="{Binding ClearDueCommand}" />
                    </Grid>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" HorizontalContentAlignment="Left" Padding="12,7"
                            Command="{Binding ShowInCalendarCommand}" IsEnabled="{Binding HasDue}"
                            Visibility="{Binding IsCalendarAvailable, Converter={StaticResource BoolToVis}}"
                            ToolTip="A nap megnyitása az openCalendar-ban">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}" FontSize="12" Foreground="{StaticResource OpenCalendarBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Megnyitás naptárban" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="BORÍTÓSZÍN" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                    <controls:ColorPicker Colors="{Binding CoverPalette}" SelectedColor="{Binding CoverColor}" SwatchSize="26" />
                    <Button Style="{StaticResource GhostButton}" Content="Nincs borító" Margin="-10,2,0,0" HorizontalAlignment="Left"
                            Command="{Binding ClearCoverCommand}" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Visibility="{Binding IsNotesAvailable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="KAPCSOLT JEGYZET" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                        <ComboBox ItemsSource="{Binding NoteChoices}" SelectedItem="{Binding SelectedNote}" DisplayMemberPath="Title"
                                  IsTextSearchEnabled="True" TextSearch.TextPath="Title" MaxDropDownHeight="320" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasLinkedNote, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource SecondaryButton}" Padding="12,6" Command="{Binding OpenNoteCommand}" ToolTip="Megnyitás az openNotes-ban">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70B;" Style="{StaticResource IconGlyph}" FontSize="12" Foreground="#5B3E96" Margin="0,0,7,0" />
                                    <TextBlock Text="Megnyitás" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Margin="4,0,0,0" Command="{Binding ClearNoteCommand}" ToolTip="Leválasztás" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE74D;" Content="Kártya törlése" Foreground="{StaticResource DangerBrush}"
                            Margin="-10,0,12,0" Command="{Binding DeleteCommand}" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12.5" TextWrapping="Wrap"
                               VerticalAlignment="Center" MaxWidth="300" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="Mégse" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Mentés" Command="{Binding SaveCommand}" ToolTip="Ctrl+S" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
